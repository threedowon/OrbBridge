// ============================================================
// HUB75
// ============================================================

#define CLK 8
#define OE  9
#define LAT 10

#define A   A0
#define B   A1
#define C   A2

RGBmatrixPanel matrix(A, B, C, CLK, LAT, OE, false);


// ============================================================
// 전역 밝기
// ============================================================

// 기준 calibration map은 8/15 밝기를 기준으로 만들어짐.
//
// 8 = 원래 보정값 그대로
// 6 = 조금 어둡게, 그래도 보정 단계 유지됨
// 5 = 더 어둡게
//
// 너무 낮추면 다시 4-bit 양자화 때문에
// 보정값 차이가 사라질 수 있음.
//
// 우선 6 추천.
uint8_t MASTER_LEVEL = 6;


// 전체 화이트밸런스 (%)
// 카메라 화이트밸런스 영향이 있으므로
// 일단 전부 100으로 두고 육안으로 마지막 조절.
uint8_t WB_R = 100;
uint8_t WB_G = 100;
uint8_t WB_B = 100;


