// ============================================================
// 0~15 범위 제한
// ============================================================

uint8_t clamp4(int value)
{
  if (value < 0)  return 0;
  if (value > 15) return 15;
  return value;
}


// ============================================================
// 전체 밝기 및 WB 적용
// ============================================================

uint8_t scaleChannel(
  uint8_t calibratedValue,
  uint8_t whiteBalance
)
{
  // CAL map의 기준 밝기는 8
  int value =
    ((int)calibratedValue * MASTER_LEVEL + 4) / 8;

  value =
    (value * whiteBalance + 50) / 100;

  return clamp4(value);
}


// ============================================================
// 보정된 WHITE 렌더
// ============================================================

void drawCalibratedWhite()
{
  for (uint8_t y = 0; y < 16; y++)
  {
    for (uint8_t x = 0; x < 32; x++)
    {
      uint16_t packed =
        pgm_read_word(&CAL444[y][x]);

      uint8_t calR = (packed >> 8) & 0x0F;
      uint8_t calG = (packed >> 4) & 0x0F;
      uint8_t calB = packed & 0x0F;

      uint8_t r = scaleChannel(calR, WB_R);
      uint8_t g = scaleChannel(calG, WB_G);
      uint8_t b = scaleChannel(calB, WB_B);

      matrix.drawPixel(
        x,
        y,
        matrix.Color444(r, g, b)
      );
    }
  }
}


// ============================================================
// SETUP
// ============================================================

void setup()
{
  matrix.begin();
  matrix.fillScreen(0);

  drawCalibratedWhite();
}


